{
  "expo": {
    "name": "Portion",
    "slug": "portion-meal-planner",
    "scheme": "portion",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.portion.mealplanner" },
    "web": { "bundler": "metro", "output": "single", "name": "Portion — your week, well fed" },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true }
  }
}
